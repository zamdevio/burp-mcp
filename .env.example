# Local paths for live Burp smoke (copy to .env and edit). Never commit .env.
#
# Destination for burp-mcp-all.jar — directory or full .jar path.
# Example (WSL → Windows Burp Extensions folder):
#   BURP_EXTENSION_JAR_DEST=/mnt/c/Users/<you>/BurpSuite/Extensions
BURP_EXTENSION_JAR_DEST=

# Optional MCP connectivity overrides for ./scripts/mcp/check.sh and test.sh
# (auto-detect if unset). BURP_MCP_WINDOWS_HOST is accepted as an alias for HOST.
# BURP_MCP_HOST=127.0.0.1
# BURP_MCP_PORT=9876
